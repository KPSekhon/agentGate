# AgentGate Configuration
# Set to "live" to use real 1Password SDK, "demo" for mock secrets
AGENTGATE_MODE=demo

# 1Password service account token (required when mode=live)
OP_SERVICE_ACCOUNT_TOKEN=

# Agent API authentication token
AGENTGATE_AGENT_TOKEN=demo-token-12345

# Database URL
AGENTGATE_DB_URL=sqlite+aiosqlite:///./agentgate.db

# Policy directory path
AGENTGATE_POLICY_DIR=./policies

# Server settings
AGENTGATE_HOST=0.0.0.0
AGENTGATE_PORT=8000
